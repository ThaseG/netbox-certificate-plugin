    {
      "name": "Security Team",
      "contact": ["Marcus Ito", "Sam O'Connor"],
      "contact_group": ["security-team"],
      "description": "Requests certificates for internal security tooling and the PKI root/intermediate CAs."
    },
    {
      "name": "Network Operations",
      "contact": ["Priya Shah"],
      "contact_group": ["network-operations"],
      "description": "Requests certificates for switches, routers and other network infrastructure."
    }
  ],
  "plugins/pki/cas/": [
    {
      "name": "Example Corp Root CA",
      "status": "manual",
      "protocol": "Internal SCEP CA",
      "expiration": "20_years",
      "cn": "Example Corp Root CA",
      "certificate": "-----BEGIN CERTIFICATE-----\nDEMOROOTCADEMOROOTCADEMOROOTCADEMOROOTCADEMOROOTCA==\n-----END CERTIFICATE-----",
      "requestor": "Security Team",
      "description": "Offline root CA. Not used to issue certificates directly."
    },
    {
      "name": "Example Corp Issuing CA 1",
      "status": "automatic-created",
      "protocol": "Internal SCEP CA",
      "parent_ca": "Example Corp Root CA",
      "expiration": "5_years",
      "default_cert_expiration": "1_year",
      "cn": "Example Corp Issuing CA 1",
      "csr": "-----BEGIN CERTIFICATE REQUEST-----\nDEMOCSRDEMOCSRDEMOCSRDEMOCSRDEMOCSRDEMOCSR==\n-----END CERTIFICATE REQUEST-----",
      "certificate": "-----BEGIN CERTIFICATE-----\nDEMOISSUINGCA1DEMOISSUINGCA1DEMOISSUINGCA1==\n-----END CERTIFICATE-----",
      "requestor": "Security Team",
      "description": "Online intermediate CA used for internal SCEP enrollment."
    },
    {
      "name": "Example Corp Public Issuing CA",
      "status": "automatic-requested",
      "protocol": "Let's Encrypt ACME",
      "expiration": "3_months",
      "default_cert_expiration": "45_days",
      "cn": "Public ACME Proxy CA",
      "description": "Represents public ACME issuance via Let's Encrypt for externally-facing services."
    },
    {
      "name": "Lab Test CA",
      "status": "manual",
      "protocol": "Lab ACME (Staging)",
      "expiration": "1_month",
      "cn": "Lab Test CA",
      "requestor": "Network Operations",
      "description": "Non-production CA used for lab and staging environment testing."
    }
  ],
