  "plugins/pki/protocols/": [
    {
      "name": "Let's Encrypt ACME",
      "type": "acme",
      "acme_directory_url": "https://acme-v02.api.letsencrypt.org/directory",
      "acme_challenge_type": "dns-01",
      "acme_account_key_ref": "vault://pki/acme/letsencrypt-account-key",
      "acme_dns_provider": "cloudflare",
      "acme_dns_credential_ref": "vault://pki/acme/cloudflare-token",
      "environment": "production",
      "description": "Public ACME issuance via Let's Encrypt for externally-facing services."
    },
    {
      "name": "Internal SCEP CA",
      "type": "scep",
      "scep_url": "https://scep.internal.example.com/scep",
      "scep_ca_fingerprint": "AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77",
      "scep_challenge_secret_ref": "vault://pki/scep/internal-challenge",
      "scep_encryption_algorithm": "aes256",
      "scep_digest_algorithm": "sha256",
      "scep_renewal_mode": "renewal",
      "environment": "production",
      "description": "Internal SCEP enrollment for network and security devices."
    },
    {
      "name": "Lab ACME (Staging)",
      "type": "acme",
      "acme_directory_url": "https://acme-staging-v02.api.letsencrypt.org/directory",
      "acme_challenge_type": "http-01",
      "acme_account_key_ref": "vault://pki/acme/staging-account-key",
      "environment": "lab",
      "description": "Staging ACME directory used for pre-production testing."
    }
  ],
  "plugins/pki/requestors/": [
    {
      "name": "Firewall Team",
      "contact": ["Dana Whitfield"],
      "contact_group": ["firewall-team"],
      "description": "Requests and manages certificates for perimeter firewalls and VPN gateways."
