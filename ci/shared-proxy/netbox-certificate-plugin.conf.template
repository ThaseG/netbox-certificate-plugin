# Rendered by ci/scripts/render-proxy-conf.sh (plain `envsubst`, restricted to
# ${NETBOX_DOMAIN} only) into $EDGE_CONF_DIR/${NETBOX_DOMAIN}.conf on the
# shared front-door proxy — see ci/shared-proxy/README.md. nginx's own
# $host/$scheme/etc runtime variables below are left untouched by that
# restriction.
#
# proxy_pass targets `netbox-certificate-plugin`, this repo's own stable
# network alias on the shared "netbox-edge" Docker network (set in
# ci/docker/docker-compose.yml) — resolvable by the front door regardless of
# which compose project actually created that container.

server {
    listen 80;
    listen [::]:80;
    server_name ${NETBOX_DOMAIN};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${NETBOX_DOMAIN};

    ssl_certificate     /etc/nginx/certs/${NETBOX_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/${NETBOX_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    client_max_body_size 25m;

    location / {
        proxy_pass http://netbox-certificate-plugin:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
