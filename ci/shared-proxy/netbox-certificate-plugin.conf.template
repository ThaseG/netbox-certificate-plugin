# Rendered by ci/scripts/render-proxy-conf.sh (plain `envsubst`, restricted to
# ${NETBOX_DOMAIN} only) into $EDGE_CONF_DIR/${NETBOX_DOMAIN}.conf on the
# shared front-door proxy — see ci/shared-proxy/README.md. nginx's own
# $host/$scheme/etc runtime variables below are left untouched by that
# restriction.
#
# proxy_pass targets `netbox-certificate-plugin`, this repo's own stable
# network alias on the shared "netbox-edge" Docker network (set in
# ci/docker/docker-compose.yml) — resolvable by the front door regardless of
# which compose project actually created that container.
#
# Resolved at *request* time (via the `resolver` + `set $backend` below),
# not at config-load time: a plain `proxy_pass http://netbox-certificate-plugin:8080;`
# forces nginx to resolve the hostname when the config is loaded/reloaded,
# which fails `nginx -t` outright if that container doesn't exist at that
# exact moment (e.g. the very first deploy, before `docker compose up` has
# run yet) — and since this front door is shared, one plugin's failed
# reload for that reason would otherwise risk aborting the reload for every
# other already-working domain's config too, since nginx tests/reloads the
# whole config as one unit. With the resolver, `nginx -t`/reload always
# succeeds; requests just 502 until the backend container actually exists.

server {
    listen 80;
    listen [::]:80;
    server_name ${NETBOX_DOMAIN};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${NETBOX_DOMAIN};

    ssl_certificate     /etc/nginx/certs/${NETBOX_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/${NETBOX_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    client_max_body_size 25m;

    # 127.0.0.11 is Docker's embedded DNS server, reachable from any
    # container on a user-defined network (the shared "netbox-edge" one
    # here) — see the comment on proxy_pass below for why this is a
    # resolver-at-request-time setup rather than a plain proxy_pass.
    resolver 127.0.0.11 valid=10s;

    location / {
        set $backend netbox-certificate-plugin;
        proxy_pass http://$backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
